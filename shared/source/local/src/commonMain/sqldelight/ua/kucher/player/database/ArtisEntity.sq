CREATE TABLE IF NOT EXISTS ArtistEntity (
 id INTEGER PRIMARY KEY NOT NULL,
 name TEXT NOT NULL,
 numberOfAlbums INTEGER NOT NULL,
 numberOfSongs INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS artist_name ON ArtistEntity(name);

getArtists:
SELECT *
FROM ArtistEntity;

getArtistById:
SELECT *
FROM ArtistEntity
WHERE id=?;

insertArtist:
INSERT OR REPLACE INTO ArtistEntity(id, name, numberOfAlbums, numberOfSongs)
VALUES ?;

deleteAllArtists:
DELETE FROM ArtistEntity;