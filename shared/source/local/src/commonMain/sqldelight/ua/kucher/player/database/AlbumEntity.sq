CREATE TABLE IF NOT EXISTS AlbumEntity (
 id INTEGER PRIMARY KEY NOT NULL,
 title TEXT NOT NULL,
 artistId INTEGER NOT NULL,
 artwork TEXT DEFAULT NULL
);

CREATE INDEX IF NOT EXISTS album_name ON AlbumEntity(title);

getAlbums:
SELECT *
FROM AlbumEntity;

getAlbumById:
SELECT *
FROM AlbumEntity
WHERE id=?;

getAlbumByArtist:
SELECT *
FROM AlbumEntity
WHERE artistId=?;

insertAlbum:
INSERT OR REPLACE INTO AlbumEntity(id, title, artistId, artwork)
VALUES ?;

deleteAlbum:
DELETE FROM AlbumEntity WHERE id=?;

deleteAllAlbums:
DELETE FROM AlbumEntity;
