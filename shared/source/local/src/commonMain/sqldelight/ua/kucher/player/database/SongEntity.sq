CREATE TABLE IF NOT EXISTS SongEntity (
 id INTEGER PRIMARY KEY NOT NULL,
 title TEXT NOT NULL,
 duration INTEGER NOT NULL,
 uri TEXT NOT NULL,
 artwork TEXT,
 albumId INTEGER NOT NULL DEFAULT -1,
 artistId INTEGER NOT NULL DEFAULT -1,
 lastModified INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS song_name ON SongEntity(title);

getSongs:
SELECT *
FROM SongEntity;

getAllSongsIds:
SELECT id
FROM SongEntity;

getSongById:
SELECT *
FROM SongEntity
WHERE id=?;

getSongsByAlbum:
SELECT *
FROM SongEntity
WHERE albumId=?;

getSongsByArtist:
SELECT *
FROM SongEntity
WHERE artistId=?;

insertSong:
INSERT INTO SongEntity(
    id,
    title,
    duration,
    uri,
    artwork,
    albumId,
    artistId,
    lastModified
)
VALUES ?;

updateSong:
UPDATE SongEntity
SET
    title=?,
    duration=?,
    uri=?,
    albumId=?,
    artistId=?,
    lastModified=?
WHERE id=?;

insertArtwork:
UPDATE SongEntity
SET artwork=?
WHERE id=?;

deleteSongById:
DELETE FROM SongEntity
WHERE id=?;


