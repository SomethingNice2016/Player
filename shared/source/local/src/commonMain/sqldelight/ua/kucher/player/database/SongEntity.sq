CREATE TABLE IF NOT EXISTS SongEntity (
 id INTEGER PRIMARY KEY NOT NULL,
 title TEXT NOT NULL,
 duration INTEGER NOT NULL,
 uri TEXT NOT NULL,
 albumId INTEGER NOT NULL DEFAULT -1,
 artistId INTEGER NOT NULL DEFAULT -1
);

CREATE INDEX IF NOT EXISTS song_name ON SongEntity(title);

getSongs:
SELECT *
FROM SongEntity;

getSongById:
SELECT *
FROM SongEntity
WHERE id=?;

getSongsByAlbum:
SELECT *
FROM SongEntity
WHERE albumId=?;

getSongsByArtist:
SELECT *
FROM SongEntity
WHERE artistId=?;

insertSong:
INSERT OR REPLACE INTO SongEntity(id, title, duration, uri, albumId, artistId)
VALUES ?;

deleteAllSongs:
DELETE FROM SongEntity;


