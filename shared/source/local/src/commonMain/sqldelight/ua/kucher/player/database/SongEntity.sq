CREATE TABLE IF NOT EXISTS SongEntity (
 id INTEGER PRIMARY KEY NOT NULL,
 title TEXT NOT NULL,
 duration INTEGER NOT NULL,
 uri TEXT NOT NULL,
 artwork TEXT,
 albumId INTEGER NOT NULL DEFAULT -1,
 artistId INTEGER NOT NULL DEFAULT -1,
 lastModified INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS song_name ON SongEntity(title);

getSongs:
SELECT *
FROM SongEntity;

getAllSongsIds:
SELECT id
FROM SongEntity;

getSongById:
SELECT *
FROM SongEntity
WHERE id=?;

getSongsWithRelations:
SELECT
    song.*,
    album.id AS albumId,
    album.title AS albumTitle,
    album.artwork AS albumArtwork,
    artist.id AS artistId,
    artist.name AS artistName,
    artist.numberOfSongs AS artistNumberOfSongs,
    artist.numberOfAlbums AS artistNumberOfAlbums
FROM SongEntity song
LEFT JOIN AlbumEntity album ON album.id = song.albumId
LEFT JOIN ArtistEntity artist ON artist.id = song.artistId;

getSongsByAlbumWithRelations:
SELECT
    song.*,
    album.id AS albumId,
    album.title AS albumTitle,
    album.artwork AS albumArtwork,
    artist.id AS artistId,
    artist.name AS artistName,
    artist.numberOfSongs AS artistNumberOfSongs,
    artist.numberOfAlbums AS artistNumberOfAlbums
FROM SongEntity song
LEFT JOIN AlbumEntity album ON album.id = song.albumId
LEFT JOIN ArtistEntity artist ON artist.id = song.artistId
WHERE song.albumId = ?;

getSongsByArtistWithRelations:
SELECT
    song.*,
    album.id AS albumId,
    album.title AS albumTitle,
    album.artwork AS albumArtwork,
    artist.id AS artistId,
    artist.name AS artistName,
    artist.numberOfSongs AS artistNumberOfSongs,
    artist.numberOfAlbums AS artistNumberOfAlbums
FROM SongEntity song
LEFT JOIN AlbumEntity album ON album.id = song.albumId
LEFT JOIN ArtistEntity artist ON artist.id = song.artistId
WHERE song.artistId = ?;

getSongByIdWithRelations:
SELECT
    song.*,
    album.id AS albumId,
    album.title AS albumTitle,
    album.artwork AS albumArtwork,
    artist.id AS artistId,
    artist.name AS artistName,
    artist.numberOfSongs AS artistNumberOfSongs,
    artist.numberOfAlbums AS artistNumberOfAlbums
FROM SongEntity song
LEFT JOIN AlbumEntity album ON album.id = song.albumId
LEFT JOIN ArtistEntity artist ON artist.id = song.artistId
WHERE song.id = ?;

getSongsByAlbum:
SELECT *
FROM SongEntity
WHERE albumId=?;

getSongsByArtist:
SELECT *
FROM SongEntity
WHERE artistId=?;

insertSong:
INSERT INTO SongEntity(
    id,
    title,
    duration,
    uri,
    artwork,
    albumId,
    artistId,
    lastModified
)
VALUES ?;

updateSong:
UPDATE SongEntity
SET
    title=?,
    duration=?,
    uri=?,
    albumId=?,
    artistId=?,
    lastModified=?
WHERE id=?;

insertArtwork:
UPDATE SongEntity
SET artwork=?
WHERE id=?;

deleteSongById:
DELETE FROM SongEntity
WHERE id=?;


